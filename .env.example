# Copy this file to .env and fill in your own key. Never commit the real .env file.
# The application runs fully in offline/rule-based mode if this is left blank.
OPENAI_API_KEY=

# Optional: override the default models used for each LLM step.
OPENAI_REQUIREMENT_MODEL=gpt-4o-mini
OPENAI_EXPLANATION_MODEL=gpt-4o-mini
